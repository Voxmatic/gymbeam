# GymOS environment — copy to .env and fill. NEVER commit real values.
# Pilot mode: everything marked OPTIONAL may be absent; safe fallbacks apply.

# --- Supabase (plain-PG local dev: scripts/pg_cluster.mjs prints equivalents) ---
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# --- Local test cluster (scripts/test_backend.py) ---
GYMOS_PGPORT=55432
GYMOS_PGDATA=.pgdata
GYMOS_PGHOST=127.0.0.1
GYMOS_PGUSER=postgres
GYMOS_PGPASSWORD=postgres

# --- Firebase Auth (phone OTP + Google) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# OPTIONAL pilot: without it push rows are marked inapp_only (in-app feed still works)
FCM_SERVICE_ACCOUNT=

# --- Razorpay (OPTIONAL pilot: counter payments only until real keys exist) ---
# Must be rzp_test_/rzp_live_ API keys — a razorpay.me payment-page link is NOT a key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Interakt WhatsApp (OPTIONAL pilot: whatsapp_enabled flag defaults OFF) ---
INTERAKT_API_KEY=
WA_TEMPLATE_EXPIRY=
WA_TEMPLATE_EXPIRY_HI=
WA_TEMPLATE_OVERDUE=
WA_TEMPLATE_OVERDUE_HI=

# --- Vault / workers ---
# generate: openssl rand -base64 32
VAULT_MASTER_KEY=
WORKER_SECRET=

# --- Web (Next.js public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FUNCTIONS_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=